NODE_ENV=development
APP_PORT=3000

# Optional. Useful on Windows if Vite cannot remove node_modules/.vite/deps.
# Example: C:\temp\lpc-528-app-vite-cache
VITE_CACHE_DIR=

LPC_HOST=192.168.200.50
LPC_PORT=23
LPC_INTERFACE_SELECTION=1
LPC_STREAM_BUFFER_LIMIT=1000
LPC_MIN_ELAPSED_STEP_SEC=0.10
LPC_AUTO_CONNECT=false
LPC_RECONNECT_ENABLED=true
LPC_RECONNECT_DELAY_MS=3000
LPC_CONNECT_TIMEOUT_MS=5000
LPC_AUTO_SELECT_INTERFACE=true
LPC_DEBUG_LINES=false
CURRENT_TEST_MAX_AGE_MS=600000
ENABLE_MOCK_LPC_ENDPOINTS=true

PROGRAM_START_MODE=mock
PROGRAM_START_COMMAND=python3
PROGRAM_START_SCRIPT_PATH=/root/eip_start_program.py

BARCODE_PROGRAM_MAP={"5901234123457":1,"7472475":1,"7472476":2,"7472477":3}

SPLUNK_HEC_URL=https://splunk.example.local:8088/services/collector
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=lpc528
SPLUNK_SOURCE=lpc-528-app
SPLUNK_SOURCETYPE=lpc:result

ZEBRA_HOST=192.168.200.60
ZEBRA_PORT=9100

BACKUP_COMMAND=python3
BACKUP_SCRIPT=/root/lpc_backup_csv.py
BACKUP_REPORT=Chan Last 100
BACKUP_TIMEOUT_SEC=120
BACKUP_LATEST_CSV=/root/.node-red/public/lpc_backup_latest.csv
