NODE_ENV=development
APP_PORT=3000

LPC_HOST=192.168.200.50
LPC_PORT=23
LPC_INTERFACE_SELECTION=1
LPC_STREAM_BUFFER_LIMIT=1000
LPC_MIN_ELAPSED_STEP_SEC=0.10

PROGRAM_STARTER_COMMAND=python3
PROGRAM_STARTER_SCRIPT=/root/eip_start_program.py

SPLUNK_HEC_URL=https://splunk.example.local:8088/services/collector
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=lpc528
SPLUNK_SOURCE=lpc-528-app
SPLUNK_SOURCETYPE=lpc:result

ZEBRA_HOST=192.168.200.60
ZEBRA_PORT=9100

BACKUP_COMMAND=python3
BACKUP_SCRIPT=/root/lpc_backup_csv.py
BACKUP_REPORT=Chan Last 100
BACKUP_TIMEOUT_SEC=120
BACKUP_LATEST_CSV=/root/.node-red/public/lpc_backup_latest.csv
