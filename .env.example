NODE_ENV=development
APP_PORT=3000
AUTH_SESSION_SECRET=change-me-super-secret
AUTH_COOKIE_NAME=lpc_auth
AUTH_COOKIE_MAX_AGE_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
DEFAULT_ADMIN_LOGIN=ADM
DEFAULT_ADMIN_PASSWORD=admin123
AUTH_RESET_DEFAULT_ADMIN=false
AUTH_DEBUG=false
AUTH_TEST_IDLE_LOGOUT_MINUTES=15
CARD_LOGIN_ENABLED=true
CARD_UID_PATTERN=^\d{8}$
CARD_SCAN_IDLE_MS=200
SQLITE_DB_PATH=data/lpc_app.sqlite

# Optional. Useful on Windows if Vite cannot remove node_modules/.vite/deps.
# Example: C:\temp\lpc-528-app-vite-cache
VITE_CACHE_DIR=
VITE_SHOW_DIAGNOSTICS=false

# LPC Telnet / streaming
# Port 23 receives LPC streaming, chart data and final results. It does not start programs.
LPC_HOST=192.168.200.50
LPC_PORT=23
LPC_INTERFACE_SELECTION=1
LPC_STREAM_BUFFER_LIMIT=1000
LPC_MIN_ELAPSED_STEP_SEC=0.10
LPC_AUTO_CONNECT=true
LPC_RECONNECT_ENABLED=true
LPC_RECONNECT_DELAY_MS=15000
LPC_CONNECT_TIMEOUT_MS=5000
LPC_HEARTBEAT_ENABLED=true
LPC_HEARTBEAT_INTERVAL_MS=5000
LPC_HEARTBEAT_TIMEOUT_MS=12000
LPC_STALE_CONNECTION_TIMEOUT_MS=15000
# Empty by default: do not send heartbeat data to LPC during tests. Example: \r\n
LPC_HEARTBEAT_PAYLOAD=
LPC_AUTO_SELECT_INTERFACE=true
LPC_DEBUG_LINES=false
LPC_DEBUG_PIPELINE=false
CURRENT_TEST_MAX_AGE_MS=600000
ACTIVE_TEST_TIMEOUT_MS=5000
ACTIVE_TEST_NO_DATA_WARNING_MS=5000
ENABLE_MOCK_LPC_ENDPOINTS=true

# LPC EtherNet/IP / program start
# Port 44818 sends P01/P02/... to LPC. LPC_HOST/LPC_PORT=23 alone is not enough for program start.
PROGRAM_START_MODE=script
PROGRAM_START_COMMAND=py
PROGRAM_START_SCRIPT_PATH=C:/Projekty/LPC528_App/LPC_528_App/scripts/eip_start_program.py
LPC_EIP_HOST=192.168.200.50
LPC_EIP_PORT=44818
EIP_DRY_RUN=false

# Barcode fallback mapping
BARCODE_PROGRAM_MAP={"5901234123457":1,"7472475":1,"7472476":2,"7472477":3}

SPLUNK_ENABLED=true
SPLUNK_HEC_URL=https://10.10.212.56:8088/services/collector/event
SPLUNK_HEC_TOKEN=
SPLUNK_INDEX=machinedata_w16
SPLUNK_SOURCE=LPC-528-01
SPLUNK_SOURCETYPE=_json
SPLUNK_SITE=W16
SPLUNK_LINE=PWT
SPLUNK_WORKPLACE=LPC-528-01
SPLUNK_DEVICE=LPC-528-01
SPLUNK_TIMEOUT_MS=5000
SPLUNK_VERIFY_TLS=false

SPLUNK_SEND_RESULT=true
SPLUNK_SEND_CURVE=true

SPLUNK_BUFFER_ENABLED=true
SPLUNK_BUFFER_RETRY_INTERVAL_MS=30000
SPLUNK_BUFFER_MAX_ATTEMPTS=0

ZEBRA_HOST=192.168.200.60
ZEBRA_PORT=9100
ZEBRA_ENABLED=true
ZEBRA_PRINT_ON_RESULT=true
ZEBRA_LABEL_WIDTH_DOTS=240
ZEBRA_LABEL_HEIGHT_DOTS=220
ZEBRA_TEXT_X=0
ZEBRA_TEXT_WIDTH_DOTS=240
ZEBRA_LINE1_Y=40
ZEBRA_LINE2_Y=75
ZEBRA_LINE3_Y=110
ZEBRA_FONT_LINE1_HEIGHT=24
ZEBRA_FONT_LINE1_WIDTH=24
ZEBRA_FONT_LINE2_HEIGHT=24
ZEBRA_FONT_LINE2_WIDTH=24
ZEBRA_FONT_LINE3_HEIGHT=20
ZEBRA_FONT_LINE3_WIDTH=20

BACKUP_COMMAND=py
BACKUP_SCRIPT=C:\Projekty\LPC528_App\LPC_528_App\scripts\lpc_backup_csv.py
BACKUP_REPORT=Chan Last 100
BACKUP_TIMEOUT_SEC=120
BACKUP_LATEST_CSV=/root/.node-red/public/lpc_backup_latest.csv
